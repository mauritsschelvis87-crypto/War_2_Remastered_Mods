<Application x:Class="SetupApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#FF1B2638"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF243044"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF2C3A52"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2EA85C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFB8C4D8"/>
    </Application.Resources>
</Application>

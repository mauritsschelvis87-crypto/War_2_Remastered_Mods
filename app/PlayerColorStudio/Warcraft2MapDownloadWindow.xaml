<Window x:Class="PlayerColorStudio.Warcraft2MapDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Download maps from warcraft2.site"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="HelpText" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13" LineHeight="20"
               Text="Log in on warcraft2.site below (your normal Chrome login is separate). When you are logged in, click Start download. Files go into your Maps\downloads folder."/>

    <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
      <wv2:WebView2 x:Name="Browser"/>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,10" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedTextBrush}" FontSize="13"
               Text="Loading browser…"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="StartButton" Content="Start download" Width="140" Height="34" Margin="0,0,10,0"
              IsEnabled="False" Click="Start_Click"
              Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="#FF7FB5FF"/>
      <Button Content="Close" Width="100" Height="34" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>

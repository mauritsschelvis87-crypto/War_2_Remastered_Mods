<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <AssemblyTitle>Quality of Life Modding</AssemblyTitle>
    <Product>Warcraft II — Quality of Life Modding</Product>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildProjectDirectory)\..\..\mod\native\DropMonitor.dll"
          Link="DropMonitor.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Window x:Class="PlayerColorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PlayerColorStudio"
        Title="Warcraft II Remastered — Quality of Life Mods"
        Width="1280" Height="1000" MinWidth="1100" MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem loc:Loc.HeaderKey="Tab.PlayerColors" Header="Player colors" Tag="colors" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   loc:Loc.TextKey="Colors.Intro"
                                   Text="Units on the battlefield, minimap, victory and ally screen all follow the selected colors."/>
                        <!-- Invisible spacer: same height as other tabs so the first box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <!-- Same header / help heights as player color cards (collapsed + expanded). -->
                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.92*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1.08*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   loc:Loc.TextKey="Colors.ColorBlindPresets"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,14"
                                                   Text="Color blindness presets"/>
                                        <StackPanel x:Name="ColorBlindPresetPanel" Grid.Column="2"
                                                    Orientation="Horizontal" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right" Margin="-18,0,36,0">
                                            <Button loc:Loc.TextKey="Btn.Custom" Content="Custom" Tag="custom" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button loc:Loc.TextKey="Colors.PresetDeuteranopia" Content="Deuteranopia" Tag="deuteranopia" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button loc:Loc.TextKey="Colors.PresetProtanopia" Content="Protanopia" Tag="protanopia" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button loc:Loc.TextKey="Colors.PresetTritanopia" Content="Tritanopia" Tag="tritanopia" Width="88" Margin="0,0,0,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="{Binding ColorBlindPresetHintText}"/>
                            </Expander>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="160"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock loc:Loc.TextKey="Label.Vanilla" Text="vanilla" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <Path Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,8,70,0"
                                                          Data="M 0,6 H 16 M 10,0 L 16,6 L 10,12"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Margin="-18,0,36,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock loc:Loc.TextKey="Label.Edited" Text="edited" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button loc:Loc.TextKey="Btn.ChooseColor" Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button loc:Loc.TextKey="Btn.Reset" Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Width="100" Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" LineHeight="20"
                                                       MinHeight="{StaticResource ColorCardHelpMinHeight}"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding OtherCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="160"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="vanilla" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <Path Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,8,70,0"
                                                          Data="M 0,6 H 16 M 10,0 L 16,6 L 10,12"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Margin="-18,0,36,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="edited" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Width="100" Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" LineHeight="20"
                                                       MinHeight="{StaticResource ColorCardHelpMinHeight}"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem loc:Loc.HeaderKey="Tab.FeatureMods" Header="Feature mods" Tag="feature" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   loc:Loc.TextKey="Feature.Intro"
                                   Text="Optional feature mods for multiplayer games. Each mod is compatible with the others — you can use them individually or simultaneously."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllyLeaveMarkHumans}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       loc:Loc.TextKey="Feature.MarkGoneHumans"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Mark gone humans"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.MarkGoneHumans.Help"
                                           Text="When a human player leaves, disconnects, or is eliminated, their name turns red on the alliances screen. Works on its own or together with Mark gone computers."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllyLeaveMarkComputers}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.MarkGoneComputers" Text="Mark gone computers"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.MarkGoneComputers.Help" Text="When a computer opponent is wiped out or eliminated, its name turns red on the alliances screen. Works in games that also have human players — only computer slots are marked."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ComputerAnnihilatedChat}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.AnnounceComputers" Text="Announce computers defeat"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.AnnounceComputers.Help" Text="Gives textual feedback when a computer player has been wiped out."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatColoredNames}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.ChatColoredNames" Text="Show chat names in player color"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.ChatColoredNames.Help" Text="Multiplayer chat lines from a player use that player's current color from Player colors. The message text remains white and clearly visible. Leave and drop messages also show the leaving player's name in their color."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatTimestamps}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.ChatTimestamps" Text="Show timestamps in chat"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.ChatTimestamps.Help" Text="Every chat line starts with the clock time it appeared, like [21:08]."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllianceTeamNumbers}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.LobbyTeamNumber" Text="Show lobby team number"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.LobbyTeamNumber.Help" Text="Puts the multiplayer team number in front of each player's name on the alliances screen, making it easier to observe games without confusion."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                Opacity="0.55">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding UpgradeNotifications}"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.UpgradeNotifications" Text="Upgrade notifications"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.UpgradeNotifications.Help" Text="Gold chat notifications when a building upgrade completes. Temporarily unavailable while this feature is being reworked."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding LobbyMapClickOpen}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.LobbyMapClickOpen" Text="Open lobby map in Explorer"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.LobbyMapClickOpen.Help" Text="In a multiplayer lobby, click the map name to open its preview image. Make sure to download the map images manually or by using this application under the Maps tab. Previews are read from your configured map images folder (Paths)."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                Opacity="0.55">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding EndGameObserve}"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Feature.ObserveAfterEnd" Text="Observe after surrender or elimination"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Feature.ObserveAfterEnd.Help" Text="Temporarily unavailable while this feature is being reworked."/>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem loc:Loc.HeaderKey="Tab.Maps" Header="Maps" Tag="maps" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   loc:Loc.TextKey="Maps.Intro"
                                   Text="Search your local map images (download them under Paths). Category stays as a filter only."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                MinHeight="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,0,14"
                                               loc:Loc.TextKey="Maps.Filters" Text="Filters"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock loc:Loc.TextKey="Maps.Search" Text="Search" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding MapsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32" Padding="10,6"
                                                 VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                                 BorderThickness="{DynamicResource ControlBorderThickness}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock loc:Loc.TextKey="Maps.Category" Text="Category" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedItem="{Binding MapsCategoryFilter}" ItemsSource="{Binding MapsCategoryOptions}"
                                                  Height="32"
                                                  Style="{StaticResource StudioComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource StudioComboBoxItemStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock loc:Loc.TextKey="Maps.Size" Text="Size" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedItem="{Binding MapsSizeFilter}" ItemsSource="{Binding MapsSizeOptions}"
                                                  Height="32"
                                                  Style="{StaticResource StudioComboBoxStyle}"

                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatDuringPauseScreen}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Bugfixes.ChatDuringPause" Text="Chat during pause screen"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Bugfixes.ChatDuringPause.Help" Text="Lets you read, type, and send chat while the multiplayer game is paused. Both players need this bug fix installed — if only one side has it, that player can send, but the other only sees the message after unpause if the chat is within its timeframe."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatHistory}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Bugfixes.ChatHistory" Text="Chat history"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Bugfixes.ChatHistory.Help" Text="Press Page Up, or hold Ctrl and press Arrow Up, in a match to bring back earlier chat messages, page by page. Page Down, or Ctrl+Arrow Down, moves forward again and returns to live chat. The last 64 messages of the current game are kept — every new game starts fresh."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                Opacity="0.55">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding MpLobbyChatScrollFix}"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Bugfixes.MpLobbyChatScroll" Text="Multiplayer lobby chat scroll"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Bugfixes.MpLobbyChatScroll.Help" Text="Keeps multiplayer lobby chat scroll position when a player changes race. Temporarily unavailable while this feature is being reworked."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding CastleGoldTooltipFix}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       loc:Loc.TextKey="Bugfixes.CastleGoldTooltip"
                                                       Text="Castle / Fortress gold bonus text"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Bugfixes.CastleGoldTooltip.Help"
                                           Text="Upgrading a Keep to a Castle (Humans) or a Stronghold to a Fortress (Orcs) grants +20% gold production, but the build tooltip incorrectly says +25%."/>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Dock=Right: first Right tab is rightmost (Settings), then Network, then Paths. -->
            <TabItem loc:Loc.HeaderKey="Tab.Settings" Header="Settings" Tag="settings" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   loc:Loc.TextKey="Settings.Intro" Text="Restore and other app settings."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">

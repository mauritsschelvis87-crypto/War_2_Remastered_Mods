                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               loc:Loc.TextKey="Settings.Language"
                                               Text="Language"/>
                                    <ComboBox Grid.Column="1" Width="{StaticResource SegmentButtonPairWidth}" Height="32"
                                              Margin="0,0,36,14"

<Window x:Class="PlayerColorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warcraft II Remastered — Quality of Life Modding"
        Width="1120" Height="1000" MinWidth="960" MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="White">
    <Grid Margin="24" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Player colors" Tag="colors" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Minimap, victory and ally screen follow the selected colors. Use the small arrow on a card for a short explanation."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="White" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="120"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="#FF7A8EAD" BorderThickness="1"/>
                                                            <TextBlock Text="vanilla" FontSize="12" Foreground="#FFB8C4D8"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="White" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" Margin="-18,0,0,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="#FF7A8EAD" BorderThickness="1"/>
                                                            <TextBlock Text="edited" FontSize="12" Foreground="#FFB8C4D8"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="#FFB8C4D8" FontSize="13" LineHeight="20"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding OtherCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="White" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="120"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="#FF7A8EAD" BorderThickness="1"/>
                                                            <TextBlock Text="vanilla" FontSize="12" Foreground="#FFB8C4D8"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="White" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" Margin="-18,0,0,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="#FF7A8EAD" BorderThickness="1"/>
                                                            <TextBlock Text="edited" FontSize="12" Foreground="#FFB8C4D8"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="#FFB8C4D8" FontSize="13" LineHeight="20"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Feature mods" Tag="feature" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Optional features for multiplayer games."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding AllyLeaveRedNames}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                          Content="Mark gone players and computers on the alliance screen (F11)."/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="When a player or computer leaves the game by disconnect, defeat or surrender, the name in the alliances screen turns red."/>
                            </StackPanel>
                        </Border>
                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ChatColoredNames}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                          Content="Show chat names in player color."/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Multiplayer chat lines from a player use that player's current color from Player colors (name only on that line)."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Bug fixes" Tag="bugfixes" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Fixes for known multiplayer annoyances."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ChatDuringPauseScreen}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                          Content="Chat during pause screen."/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Lets you read, type, and send chat while the multiplayer game is paused. Both players need this bug fix installed — if only one side has it, that player can send, but the other only sees the message after unpause if the chat is within its timeframe."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Info" Tag="info" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="About this Quality of Life Modding tool."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                                           Text="Warcraft II Remastered — Quality of Life Modding"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#FFB8C4D8" FontSize="14"
                                           Text="{Binding AppVersionText}"/>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="White"
                                           Text="Work in progress. I welcome hints, tips, and suggestions — please share what would help you."/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Author: Avent (Battle.net account)."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                                           Text="How it works"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="White"
                                           Text="1. Change colors, features, or bug fixes on the other tabs."/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="White"
                                           Text="2. Press Apply to install your choices into the game files (with a local vanilla backup)."/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="White"
                                           Text="3. Restart Warcraft II Remastered so the new files load."/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Feature and bug-fix hooks keep working after you close this app. A small watcher can start with Windows and inject them when the game runs."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                                           Text="Restore to clean game files"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="White"
                                           Text="Restore (fast): use the Restore button below. It puts back the vanilla files from this app’s local backup and turns extras off."/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Battle.net Scan and Repair (slow): also resets game files, but takes longer and is the fallback if you prefer Blizzard’s repair."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Dock=Right: first Right tab is rightmost (Info), then Path. -->
            <TabItem Header="Path" Tag="path" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Set the Warcraft II Remastered install folder used by Apply and Restore."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                                           Text="Game install path"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Choose the folder that contains Warcraft II Remastered (the one with an x86 folder). Most installs use the default below."/>
                                <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Width="420" Text="{Binding GameInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsApplyEnabled}"
                                             VerticalContentAlignment="Center" Padding="8,6"
                                             LostFocus="GameInstallPath_LostFocus"/>
                                    <Button Grid.Column="1" Content="Browse..." Width="100" Height="32" Margin="10,0,0,0"
                                            IsEnabled="{Binding IsApplyEnabled}" Click="BrowseGamePath_Click"/>
                                    <Button Grid.Column="2" Content="Default" Width="90" Height="32" Margin="8,0,0,0"
                                            IsEnabled="{Binding IsApplyEnabled}" Click="DefaultGamePath_Click"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Press Apply on this tab to save the path. Other tabs then patch that install."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding StatusLines}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                                           Text="{Binding Icon}" Foreground="{Binding IconBrush}"/>
                                <TextBlock VerticalAlignment="Center" Foreground="White" Text="{Binding Text}"
                                           TextWrapping="Wrap" MaxWidth="520"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar x:Name="ApplyProgressBar" Width="140" Height="8" Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsApplying}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Apply" Width="110" Height="36" Foreground="White"
                        Background="{Binding ApplyButtonBrush}" BorderBrush="{Binding ApplyButtonBorderBrush}"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Apply_Click"/>
                <Button Content="Restore" Width="110" Height="36" Margin="12,0,0,0"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Visibility="{Binding IsRestoreVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Restore_Click"/>
                <Button Content="Close" Width="110" Height="36" Margin="12,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

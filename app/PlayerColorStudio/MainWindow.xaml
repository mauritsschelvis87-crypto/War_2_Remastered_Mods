<Window x:Class="PlayerColorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warcraft II — Quality of Life Modding"
        Width="1120" Height="820" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="White">
    <Grid Margin="24" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Minimap, victory and ally screen follow the selected colors."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White"
                                   Text="Player 8 cannot be changed yet (shared yellow palette with the build bar). Player 2 uses exclusive band 212–215."/>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14" CornerRadius="8"
                                            Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.92*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.08*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="78">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="original" FontSize="12" Foreground="#FFB8C4D8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Width="42" Height="42" CornerRadius="5"
                                                        Background="{Binding VanillaBrush}"
                                                        BorderBrush="#FF7A8EAD" BorderThickness="1"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding VanillaHex}" Margin="10,0,0,0"
                                                           Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="-18,0,0,0">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="78">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="editable" FontSize="12" Foreground="#FFB8C4D8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Width="42" Height="42" CornerRadius="5"
                                                        Background="{Binding CurrentBrush}"
                                                        BorderBrush="#FF7A8EAD" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                         IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                        Tag="{Binding}" Click="ChooseColor_Click"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                        Tag="{Binding}" Click="ResetCard_Click"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Extra">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White"
                                   Text="Optional multiplayer QoL. These features use a runtime hook and are experimental."/>
                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AllyLeaveRedNames}"
                                          Content="Mark gone players and computers on the Alliances screen"/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Alliances opens with F11 (or Allies button upper-right) — not F5. When a human leaves/drops or a computer/NPC clan is wiped (no units and no buildings left), that row shows '[X] Clan Name' in red. Keep Extra ON and leave this app open while starting the game so the hook injects. Keep Alliances open to see marks update live. Status bar must say the marker is enabled; also check %TEMP%\war2_ally_leave_hook.log."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="{Binding Status}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="110" Height="36"
                        Background="{StaticResource AccentBrush}" BorderBrush="#FF8EC4FF" Click="Apply_Click"/>
                <Button Content="Close" Width="110" Height="36" Margin="12,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Paths.MapsFolder.Help"
                                           Text="The folder where your custom maps live (usually x86\Maps). Download saves .pud maps from warcraft2.site into the downloads subfolder. Open shows the folder in Explorer."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               loc:Loc.TextKey="Maps.Images" Text="Map images"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <TextBox Width="420" Text="{Binding MapImagesPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsApplyEnabled}"
                                                 BorderBrush="{Binding MapImagesPathBorderBrush}"
                                                 VerticalContentAlignment="Center" Padding="8,6"/>
                                        <Button Content="Browse..." Width="100" Height="32" Margin="10,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="BrowseMapImagesPath_Click"/>
                                        <Button Content="Default" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="DefaultMapImagesPath_Click"/>
                                        <Button Content="Open" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsMapImagesOpenEnabled}" Click="MapsOpenImagesFolder_Click"/>
                                        <Button Width="110" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsMapsDownloadEnabled}"
                                                Click="MapsImagesAction_Click"
                                                 Content="Download"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Maps.Images.Help"
                                           Text="Local .webp previews for lobby map click and the Maps tab. Download fills this folder from warcraft2.site."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding StatusLines}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                                           Text="{Binding Icon}" Foreground="{Binding IconBrush}"/>
                                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Text="{Binding Text}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxWidth" Value="520"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsColorsStatusSingleLine, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="MaxWidth" Value="10000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar x:Name="ApplyProgressBar" Width="140" Height="8" Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsApplying}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button loc:Loc.TextKey="Btn.Apply" Content="Apply" Width="110" Height="36" Foreground="White"
                        Background="{Binding ApplyButtonBrush}" BorderBrush="{Binding ApplyButtonBorderBrush}"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Apply_Click"/>
                <Button loc:Loc.TextKey="Btn.Close" Content="Close" Width="110" Height="36" Margin="12,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>



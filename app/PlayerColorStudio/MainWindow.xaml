                                        <GridView>
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource MonitorGridViewColumnHeaderStyle}"/>
                                            </GridView.ColumnHeaderContainerStyle>
                                            <GridViewColumn loc:Loc.HeaderKey="Network.Col.Seat" Header="Seat" Width="48" DisplayMemberBinding="{Binding Seat}"/>
                                            <GridViewColumn loc:Loc.HeaderKey="Network.Col.Player" Header="Player" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn loc:Loc.HeaderKey="Network.Col.LastMs" Header="Last ms" Width="72" DisplayMemberBinding="{Binding LastMs}"/>
                                            <GridViewColumn loc:Loc.HeaderKey="Network.Col.MaxMs" Header="Max ms" Width="72" DisplayMemberBinding="{Binding MaxMs}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="{Binding NetworkMonitorSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NetworkMonitorLog, Mode=OneWay}"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

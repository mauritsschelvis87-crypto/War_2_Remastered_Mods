                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Tileset}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PlayerCount}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"/>

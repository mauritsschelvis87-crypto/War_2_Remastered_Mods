                                                Width="{StaticResource SegmentButtonWidth}" Height="32" Padding="10,0"
                                                BorderThickness="2"
                                                IsEnabled="{Binding IsApplyEnabled}"
                                                Click="ColorBlindOff_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Settings.ColorBlindMode.Help" Text="Makes this app easier to read: light background, clear borders, and high-contrast text. Does not change in-game colors."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               loc:Loc.TextKey="Settings.RestoreClean" Text="Restore to clean game files"/>
                                    <Button Grid.Column="1" loc:Loc.TextKey="Btn.Restore" Content="Restore" Width="88" Margin="0,0,36,14" Padding="10,4"
                                            BorderThickness="2"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsEnabled="{Binding IsApplyEnabled}"
                                            Click="Restore_Click"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           loc:Loc.TextKey="Settings.RestoreClean.Help" Text="Restore (fast) puts back the vanilla files from this app’s local backup and turns extras off. Battle.net Scan and Repair is slower and the fallback if you prefer Blizzard’s repair."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem loc:Loc.HeaderKey="Tab.Network" Header="Network" Tag="network" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   loc:Loc.TextKey="Network.Intro" Text="Lockstep tick-gap monitor for MP debug (v1). Not real per-player ping — a log foundation for a future /jitter command."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding NetworkMonitor}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                          Margin="0,0,0,10">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"
                                               loc:Loc.TextKey="Network.MonitorTitle" Text="Multiplayer network monitor"/>
                                </CheckBox>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20" Margin="0,0,0,12"
                                           loc:Loc.TextKey="Network.Monitor.Help" Text="V1 debug tool: during an MP match this measures time between game ticks (lockstep — everyone shares the same tick). Large gaps mean hitch/stall, not ICMP ping per player. Human players only in the list (no Computer). Writes a snapshot every second to %TEMP%\war2_network_monitor.log for later /jitter and analysis."/>
                                <TextBlock Text="{Binding NetworkMonitorStatus}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,0,0,8"/>
                                <ListView ItemsSource="{Binding NetworkSeats}" Height="220" Margin="0,0,0,8"
                                          Style="{StaticResource MonitorListViewStyle}"
                                          ItemContainerStyle="{StaticResource MonitorListViewItemStyle}">

<Window x:Class="PlayerColorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warcraft II Remastered — Quality of Life Mods"
        Width="1120" Height="1000" MinWidth="960" MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Player colors" Tag="colors" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="Units on the battlefield, minimap, victory and ally screen all follow the selected colors."/>
                        <!-- Invisible spacer: same height as other tabs so the first box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <!-- Same header / help heights as player color cards (collapsed + expanded). -->
                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.92*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1.08*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,14"
                                                   Text="Color blindness presets"/>
                                        <StackPanel x:Name="ColorBlindPresetPanel" Grid.Column="2"
                                                    Orientation="Horizontal" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right" Margin="-18,0,36,0">
                                            <Button Content="Original" Tag="original" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button Content="Deuteranopia" Tag="deuteranopia" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button Content="Protanopia" Tag="protanopia" Width="88" Margin="0,0,8,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                            <Button Content="Tritanopia" Tag="tritanopia" Width="88" Margin="0,0,0,14" Padding="10,4"
                                                    BorderThickness="2" Click="ColorBlindPreset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="{Binding ColorBlindPresetHintText}"/>
                            </Expander>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="120"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="vanilla" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <Path Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,8,70,0"
                                                          Data="M 0,6 H 16 M 10,0 L 16,6 L 10,12"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Margin="-18,0,36,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="edited" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Width="100" Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" LineHeight="20"
                                                       MinHeight="{StaticResource ColorCardHelpMinHeight}"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding OtherCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Expander Style="{StaticResource HelpExpanderStyle}">
                                            <Expander.Header>
                                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.92*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="1.08*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                                   Margin="0,0,14,14" MinWidth="120"/>
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,14,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding VanillaBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="vanilla" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding VanillaHex}"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="14"
                                                                   Margin="0,0,0,14"/>
                                                    </StackPanel>

                                                    <Path Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,8,70,0"
                                                          Data="M 0,6 H 16 M 10,0 L 16,6 L 10,12"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                                                Margin="-18,0,36,0">
                                                        <StackPanel VerticalAlignment="Top" Margin="0,0,10,0">
                                                            <Border Width="36" Height="28" CornerRadius="4"
                                                                    Background="{Binding CurrentBrush}"
                                                                    BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="{DynamicResource SwatchBorderThickness}"/>
                                                            <TextBlock Text="edited" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                                 IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                                 VerticalAlignment="Center" Margin="0,0,10,14"/>
                                                        <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ChooseColor_Click"
                                                                VerticalAlignment="Center" Margin="0,0,8,14"
                                                                Padding="10,4"/>
                                                        <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                                Tag="{Binding}" Click="ResetCard_Click"
                                                                VerticalAlignment="Center" Margin="0,0,0,14"
                                                                Width="100" Padding="10,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" LineHeight="20"
                                                       MinHeight="{StaticResource ColorCardHelpMinHeight}"/>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Feature mods" Tag="feature" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="Optional feature mods for multiplayer games. Each mod is compatible with the others — you can use them individually or simultaneously."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllyLeaveMarkComputers}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Mark gone computers"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="When a computer opponent is wiped out or eliminated, its name turns red on the alliances screen. Works in games that also have human players — only computer slots are marked."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllyLeaveMarkHumans}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Mark gone humans"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="When a human player leaves, disconnects, or is eliminated, their name turns red on the alliances screen. Works on its own or together with Mark gone computers."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatColoredNames}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Show chat names in player color"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Multiplayer chat lines from a player use that player's current color from Player colors. The message text remains white and clearly visible. Leave and drop messages also show the leaving player's name in their color."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatTimestamps}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Show timestamps in chat"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Every chat line starts with the clock time it appeared, like [21:08]."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                Opacity="0.55">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding EndGameObserve}"
                                                  IsEnabled="False"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Observe after surrender or elimination"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Temporarily unavailable while this feature is being reworked."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding AllianceTeamNumbers}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Show lobby team number"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Puts the multiplayer team number in front of each player's name on the alliances screen, making it easier to observe games without confusion."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ComputerAnnihilatedChat}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Announce computers defeat"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Gives textual feedback when a computer player has been wiped out."/>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Bug fixes" Tag="bugfixes" DockPanel.Dock="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="Fixes for known multiplayer annoyances."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatDuringPauseScreen}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Chat during pause screen"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Lets you read, type, and send chat while the multiplayer game is paused. Both players need this bug fix installed — if only one side has it, that player can send, but the other only sees the message after unpause if the chat is within its timeframe."/>
                            </Expander>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <Expander Style="{StaticResource HelpExpanderStyle}">
                                <Expander.Header>
                                    <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                        <CheckBox IsChecked="{Binding ChatHistory}"
                                                  IsEnabled="{Binding IsApplyEnabled}"
                                                  Margin="0,0,0,14" VerticalAlignment="Center">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Text="Chat history (Page Up / Page Down)"/>
                                        </CheckBox>
                                    </Grid>
                                </Expander.Header>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Press Page Up in a match to bring back earlier chat messages, page by page. Page Down moves forward again and returns to live chat. The last 64 messages of the current game are kept — every new game starts fresh."/>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Dock=Right: first Right tab is rightmost (Settings), then About, then Paths. -->
            <TabItem Header="Settings" Tag="settings" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="Restore and other app settings."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Color blind mode"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Margin="0,0,36,14">
                                        <Button x:Name="ColorBlindOnButton" Content="On" Width="88" Margin="0,0,8,0" Padding="10,4"
                                                BorderThickness="2"
                                                IsEnabled="{Binding IsApplyEnabled}"
                                                Click="ColorBlindOn_Click"/>
                                        <Button x:Name="ColorBlindOffButton" Content="Off" Width="88" Padding="10,4"
                                                BorderThickness="2"
                                                IsEnabled="{Binding IsApplyEnabled}"
                                                Click="ColorBlindOff_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Makes this app easier to read: light background, clear borders, and high-contrast text. Does not change in-game colors."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Restore to clean game files"/>
                                    <Button Grid.Column="1" Content="Restore" Width="88" Margin="0,0,36,14" Padding="10,4"
                                            BorderThickness="2"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            IsEnabled="{Binding IsApplyEnabled}"
                                            Click="Restore_Click"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Restore (fast) puts back the vanilla files from this app’s local backup and turns extras off. Battle.net Scan and Repair is slower and the fallback if you prefer Blizzard’s repair."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="About" Tag="info" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="About this Quality of Life Mods tool."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Warcraft II Remastered — Quality of Life Mods"/>
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,36,14"
                                               Text="{Binding AppVersionText}"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Work in progress. I welcome hints, tips, and suggestions — please share what would help you. Author: Avent (Battle.net account)."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="How it works"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="1. Change colors, features, or bug fixes. 2. Press Apply (local vanilla backup). 3. Restart Warcraft II Remastered. 4. Use Settings to restore if needed. Hooks keep working after you close this app via a small Windows watcher."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Drop monitor" Tag="dropmonitor" DockPanel.Dock="Right">
                <Grid Margin="16" Background="{DynamicResource PanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Drop monitor" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Start the monitor before testing a mod. The live log records what the game reports around a player drop."/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Start monitor" Width="130" Height="34" Margin="0,0,8,0"
                            IsEnabled="{Binding DropMonitorCanStart}"
                                Click="StartDropMonitor_Click"/>
                        <Button Content="Stop monitor" Width="130" Height="34"
                                IsEnabled="{Binding DropMonitorEnabled}"
                                Click="StopDropMonitor_Click"/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding DropMonitorStatus}"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Padding="12" Margin="0,0,8,0" CornerRadius="8"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}">
                            <TextBox Text="{Binding DropMonitorLog, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="NoWrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <Border Grid.Column="1" Padding="14" CornerRadius="8"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <TextBlock Text="Latest cause" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding DropMonitorLastCause}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Paths" Tag="path" DockPanel.Dock="Right">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{DynamicResource PanelBrush}">
                    <StackPanel Background="{DynamicResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="Set your Warcraft II Remastered paths. Changes are saved automatically."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Game install path"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <TextBox Width="420" Text="{Binding GameInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsApplyEnabled}"
                                                 BorderBrush="{Binding GameInstallPathBorderBrush}"
                                                 VerticalContentAlignment="Center" Padding="8,6"
                                                 LostFocus="GameInstallPath_LostFocus"/>
                                        <Button Content="Browse..." Width="100" Height="32" Margin="10,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="BrowseGamePath_Click"/>
                                        <Button Content="Default" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="DefaultGamePath_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Choose the folder that contains Warcraft II Remastered (the one with an x86 folder). Mods and bug fixes install here. If the initial path is accepted, no changes are needed."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Map editor path"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <TextBox Width="420" Text="{Binding MapEditorPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsApplyEnabled}"
                                                 BorderBrush="{Binding MapEditorPathBorderBrush}"
                                                 VerticalContentAlignment="Center" Padding="8,6"
                                                 LostFocus="GameInstallPath_LostFocus"/>
                                        <Button Content="Browse..." Width="100" Height="32" Margin="10,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="BrowseMapEditorPath_Click"/>
                                        <Button Content="Default" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="DefaultMapEditorPath_Click"/>
                                        <Button Content="Open" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="OpenMapEditor_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="Points to Warcraft II Map Editor.exe inside your install. Open launches the map editor. For future upgrades; useful for quick access now."/>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                Height="{StaticResource ExpandedColorCardMinHeight}"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource CardBorderThickness}">
                            <StackPanel>
                                <Grid MinHeight="{StaticResource ColorCardHeaderMinHeight}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,14"
                                               Text="Maps folder path"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <TextBox Width="420" Text="{Binding MapsPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsApplyEnabled}"
                                                 BorderBrush="{Binding MapsPathBorderBrush}"
                                                 VerticalContentAlignment="Center" Padding="8,6"
                                                 LostFocus="GameInstallPath_LostFocus"/>
                                        <Button Content="Browse..." Width="100" Height="32" Margin="10,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="BrowseMapsPath_Click"/>
                                        <Button Content="Default" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsApplyEnabled}" Click="DefaultMapsPath_Click"/>
                                        <Button Content="Open" Width="90" Height="32" Margin="8,0,0,0"
                                                IsEnabled="{Binding IsMapsOpenEnabled}" Click="OpenMapsFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13" LineHeight="20"
                                           MinHeight="{StaticResource ColorCardHelpMinHeight}"
                                           Text="The folder where your custom maps live (x86\Maps in most installs). Open shows it in Windows Explorer. For future upgrades; useful for quick access now."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding StatusLines}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                                           Text="{Binding Icon}" Foreground="{Binding IconBrush}"/>
                                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Text="{Binding Text}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxWidth" Value="520"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsColorsStatusSingleLine, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                    <Setter Property="MaxWidth" Value="10000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar x:Name="ApplyProgressBar" Width="140" Height="8" Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsApplying}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Apply" Width="110" Height="36" Foreground="White"
                        Background="{Binding ApplyButtonBrush}" BorderBrush="{Binding ApplyButtonBorderBrush}"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Click="Apply_Click"/>
                <Button Content="Close" Width="110" Height="36" Margin="12,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

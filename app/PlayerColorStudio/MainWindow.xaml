<Window x:Class="PlayerColorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warcraft II Remastered — Quality of Life Modding"
        Width="1120" Height="920" MinWidth="960" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="White">
    <Grid Margin="24" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Player colors" Tag="colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Minimap, victory and ally screen follow the selected colors."/>
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14" CornerRadius="8"
                                            Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1"
                                            Opacity="{Binding IsEnabled, Converter={StaticResource BooleanToOpacityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.92*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.08*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="78">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="original" FontSize="12" Foreground="#FFB8C4D8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Width="42" Height="42" CornerRadius="5"
                                                        Background="{Binding VanillaBrush}"
                                                        BorderBrush="#FF7A8EAD" BorderThickness="1"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding VanillaHex}" Margin="10,0,0,0"
                                                           Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="-18,0,0,0">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="78">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="editable" FontSize="12" Foreground="#FFB8C4D8" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Width="42" Height="42" CornerRadius="5"
                                                        Background="{Binding CurrentBrush}"
                                                        BorderBrush="#FF7A8EAD" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Width="110" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}"
                                                         IsEnabled="{Binding IsEnabled}" LostFocus="Hex_LostFocus"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="Choose color..." IsEnabled="{Binding IsEnabled}"
                                                        Tag="{Binding}" Click="ChooseColor_Click"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="Reset" IsEnabled="{Binding IsEnabled}"
                                                        Tag="{Binding}" Click="ResetCard_Click"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Util colors" Tag="util">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Utility colors used by the game UI, such as selection highlights."/>
                        <!-- Invisible spacer: same height as Player colors second line so boxes start level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White"
                                           Text="Selection highlight"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Coming soon. This will let you change the color used when selecting your own units."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Extra" Tag="extra">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{StaticResource PanelBrush}">
                    <StackPanel Background="{StaticResource PanelBrush}">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="White"
                                   Text="Optional extras for multiplayer games to increase the quality of life."/>
                        <!-- Invisible spacer: same height as Colors tab second line so the box starts level. -->
                        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" Foreground="White" Visibility="Hidden"
                                   Text="Player 8 cannot be changed yet, I am working on it."/>
                        <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding AllyLeaveRedNames}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                          Content="Mark gone players and computers on the alliance screen (F11)."/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="When a player or computer leaves the game by disconnect, defeat or surrender, the name in the alliances screen turns red."/>
                            </StackPanel>
                        </Border>
                        <Border Padding="14" CornerRadius="8"
                                Background="{StaticResource CardBrush}" BorderBrush="#FF4A6388" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ChatDuringPauseScreen}"
                                          IsEnabled="{Binding IsApplyEnabled}"
                                              Content="Chat during pause screen."/>
                                <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="#FFB8C4D8" FontSize="12"
                                           Text="Allows reading and sending chat while the multiplayer game is paused."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding StatusLines}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                                           Text="{Binding Icon}" Foreground="{Binding IconBrush}"/>
                                <TextBlock VerticalAlignment="Center" Foreground="White" Text="{Binding Text}"
                                           TextWrapping="Wrap" MaxWidth="520"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Width="140" Height="8" Margin="12,0,0,0" VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsApplying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Apply" Width="110" Height="36" Foreground="White"
                        Background="{Binding ApplyButtonBrush}" BorderBrush="{Binding ApplyButtonBorderBrush}"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Click="Apply_Click"/>
                <Button Content="Close" Width="110" Height="36" Margin="12,0,0,0"
                        IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="PlayerColorStudio.StudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
            CornerRadius="10" Margin="14" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <Grid Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Margin="20,0,0,0" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <Button Grid.Column="1" Content="✕" Width="34" Height="30" Margin="0,0,10,0"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextBrush}"
                        Click="No_Click"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource ControlBorderBrush}"/>
            <Grid Margin="20,18,20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="18"
                        Background="#334E9DFF" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" Text="i" FontSize="17" FontWeight="Bold"
                               Foreground="#FF4E9DFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="MessageText" Grid.Column="1" Margin="14,6,0,0"
                           TextWrapping="Wrap" MaxWidth="430" MinWidth="240"
                           Foreground="{DynamicResource TextBrush}" FontSize="13" LineHeight="20"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,18">
                <Button x:Name="NoButton" Content="No" MinWidth="92" Margin="0,0,10,0"
                        Visibility="Collapsed" IsCancel="True" Click="No_Click"/>
                <Button x:Name="OkButton" Content="OK" MinWidth="92"
                        Background="{DynamicResource AccentBrush}" BorderBrush="#FF7FB5FF"
                        Foreground="White"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
